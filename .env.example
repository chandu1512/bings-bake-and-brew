# Copy this file to .env.local and fill in what you have.
# Everything is optional: with nothing set, checkout runs in TEST MODE
# (orders go through, nobody is charged, and staff see them marked "TEST").

# --- Payments (Stripe) -------------------------------------------------------
# dashboard.stripe.com -> Developers -> API keys. Use the sk_test_/pk_test_ pair
# first, then swap for sk_live_/pk_live_ when ready to take real money.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers -> Webhooks -> add https://YOUR-SITE/api/stripe/webhook,
# event "payment_intent.succeeded", then paste its signing secret here.
STRIPE_WEBHOOK_SECRET=

# --- Live orders page (/staff) ----------------------------------------------
STAFF_PASSWORD=

# --- Order emails (Resend, resend.com) ---------------------------------------
RESEND_API_KEY=
ORDER_EMAIL_FROM="Bing's Orders <orders@bingsbakeandbrew.com>"
ORDER_EMAIL_AMSTEL=
ORDER_EMAIL_ELKTON=

# --- Order texts (Twilio, twilio.com) ----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ORDER_SMS_AMSTEL=+13027513177
ORDER_SMS_ELKTON=+16672150237
